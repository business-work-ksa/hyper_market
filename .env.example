# Copier en .env et adapter. Ne jamais versionner le fichier .env.
DEBUG=True
SECRET_KEY=changez-moi-en-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Sans DATABASE_URL, le projet bascule sur SQLite : pratique pour les tests, jamais pour la
# production — les triggers du journal comptable ne s'y installent pas (docs/09).
DATABASE_URL=postgres://hypermarche:hypermarche@localhost:5432/hypermarche

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=True

LOG_LEVEL=INFO
