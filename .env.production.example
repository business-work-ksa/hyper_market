# Réglages de production. Copier en `.env.production`, remplir, ne jamais versionner.
#
# Ce fichier n'a pas de valeur par défaut utilisable : chaque ligne vide ici est
# une ligne qu'il faut décider. C'est délibéré — un secret par défaut qui marche
# est un secret qui part en production.

# ---------------------------------------------------------------------------
# Obligatoire
# ---------------------------------------------------------------------------
# 50 caractères aléatoires. Pour en produire une :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# La changer invalide toutes les sessions ouvertes — donc tous les commerçants
# connectés sont déconnectés. À faire une fois, avant la première mise en ligne.
SECRET_KEY=

# Les noms d'hôte que l'application accepte de servir, séparés par des virgules.
# Sans cette variable, le démarrage échoue : `["*"]` désarmerait la protection
# contre les en-têtes `Host` falsifiés.
ALLOWED_HOSTS=hypermarche.cm,www.hypermarche.cm

# Origines complètes, schéma compris. Sans elles, derrière un proxy, toute
# soumission de formulaire est refusée pour CSRF — et le message ne dit pas
# pourquoi.
CSRF_TRUSTED_ORIGINS=https://hypermarche.cm,https://www.hypermarche.cm

# Mot de passe du rôle PostgreSQL applicatif. Lu par `docker-compose.prod.yml`
# pour composer `DATABASE_URL` ; ne pas écrire `DATABASE_URL` à la main ici.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Optionnel
# ---------------------------------------------------------------------------
# POSTGRES_DB=hypermarche
# POSTGRES_USER=hypermarche
# PORT_PUBLIC=8000

# HSTS commence court, et s'allonge une fois le certificat éprouvé (31536000 =
# un an). Poser un an dès la première mise en ligne enferme le domaine en HTTPS
# dans le navigateur de chaque visiteur, et cela ne se retire pas à distance.
# SECURE_HSTS_SECONDS=3600
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# À mettre à False **uniquement** si le reverse proxy redirige déjà HTTP vers
# HTTPS lui-même : deux redirections en cascade font une boucle.
# SECURE_SSL_REDIRECT=True

LOG_LEVEL=INFO
