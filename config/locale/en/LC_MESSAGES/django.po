#: templates/plateforme/boutique.html:30
msgid "Voir l'activité"
msgstr "See activity"

#: templates/plateforme/boutique.html:43
#, python-format
msgid "%(impayes)s facture de loyer échue"
msgid_plural "%(impayes)s factures de loyer échues"
msgstr[0] "%(impayes)s overdue rent invoice"
msgstr[1] "%(impayes)s overdue rent invoices"

#: templates/plateforme/boutique.html:43
#, python-format
msgid "— reste dû %(reste)s FCFA."
msgstr "— %(reste)s FCFA still due."

#: templates/plateforme/boutique.html:44
msgid ""
"Une suspension retire la boutique de la vitrine sans lui couper son back-"
