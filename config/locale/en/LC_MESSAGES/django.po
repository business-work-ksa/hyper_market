#: apps/accounting/services.py:72
#, python-format
msgid "Aucun exercice ouvert ne couvre le %(date_ecriture)s."
msgstr "No open financial year covers %(date_ecriture)s."

#: apps/accounting/services.py:74
msgid "L'exercice est clôturé : passez l'écriture sur l'exercice suivant."
msgstr "This financial year is closed: post the entry to the next one."

#: apps/accounting/services.py:84
#, python-format
msgid ""
"Le compte %(numero)s n'existe pas dans le plan de cette boutique. "
"Initialisez le plan comptable (commande `initialiser_plan_comptable`)."
msgstr ""
"Account %(numero)s does not exist in this shop's chart of accounts. "
"Initialise the chart of accounts (command `initialiser_plan_comptable`)."

#: apps/accounting/services.py:129
msgid "Une écriture sans ligne n'a pas de sens."
msgstr "An entry without lines makes no sense."

#: apps/accounting/services.py:135
#, python-format
msgid ""
"Écriture déséquilibrée : débit %(total_debit)s ≠ crédit %(total_credit)s."
msgstr "Unbalanced entry: debit %(total_debit)s ≠ credit %(total_credit)s."

#: apps/accounting/services.py:138
msgid "Une écriture de montant nul n'a pas de sens."
msgstr "A zero-amount entry makes no sense."

#: apps/accounting/services.py:145
#, python-format
msgid "Le journal %(code_journal)s n'existe pas pour cette boutique."
msgstr "Journal %(code_journal)s does not exist for this shop."

#: apps/accounting/services.py:186
msgid "Cette écriture a déjà été contre-passée."
msgstr "This entry has already been reversed."

#: apps/accounting/services.py:656
#, python-format
msgid ""
"Aucun compte de trésorerie n'est prévu pour l'opérateur %(operateur)s : "
"complétez le plan comptable avant d'ouvrir ce pays."
msgstr ""
"No cash account is set up for operator %(operateur)s: complete the chart of "
"accounts before opening this country."

#: apps/accounting/services.py:799
msgid "comptabiliser_reglement_cahier attend un règlement de cahier."
msgstr "comptabiliser_reglement_cahier expects a credit book payment."

#: apps/accounting/services.py:810
#, python-format
msgid "Moyen de règlement « %(moyen)s » sans compte de trésorerie associé."
msgstr "Payment method “%(moyen)s” has no linked cash account."

#: apps/affiliation/models.py:67
msgid "Un apporteur ne peut pas se parrainer lui-même."
msgstr "A referrer cannot sponsor themselves."

#: apps/affiliation/models.py:69
msgid "Rattachement circulaire."
msgstr "Circular link."

#: apps/affiliation/models.py:71
msgid "Cet apporteur a déjà un parrain : la filiation est définitive."
msgstr "This referrer already has a sponsor: the link is permanent."

#: apps/affiliation/services.py:160
#, python-format
msgid ""
"Cumul de commissions apporteurs %(cumul)s supérieur au plafond "
"(%(plafond)s)."
msgstr "Total referrer commissions %(cumul)s exceed the cap (%(plafond)s)."

#: apps/affiliation/services.py:220
msgid "La sous-commande n'est pas livrée."
msgstr "The sub-order has not been delivered."

#: apps/backoffice/forms.py:225
msgid "Cette référence existe déjà dans votre boutique."
msgstr "This reference already exists in your shop."

#: apps/backoffice/forms.py:263
msgid ""
"Ce métier suit les péremptions : indiquez la date, ou saisissez une quantité"
" nulle et faites une réception ensuite."
msgstr ""
"This trade tracks expiry dates: enter the date, or enter a zero quantity and"
" record a receipt afterwards."

#: apps/backoffice/forms.py:272
msgid "Le coût d'achat dépasse le prix de vente : vous vendriez à perte."
msgstr ""
"The purchase cost exceeds the selling price: you would sell at a loss."

#: apps/backoffice/forms.py:359
msgid "Aucun numéro lisible dans cette saisie."
msgstr "No readable number in this entry."

#: apps/backoffice/forms.py:417
#, python-format
msgid ""
"%(len)s numéros pour %(quantite)s reçus : corrigez la quantité ou retirez "
"les numéros en trop."
msgstr ""
"%(len)s numbers for %(quantite)s received: fix the quantity or remove the "
"extra numbers."

#: apps/backoffice/forms.py:470
msgid "Ce dépôt n'existe pas dans votre boutique."
msgstr "This warehouse does not exist in your shop."

#: apps/backoffice/forms.py:535
msgid "Ce rôle ne peut pas être attribué dans une boutique."
msgstr "This role cannot be assigned in a shop."

#: apps/backoffice/forms.py:554
msgid "Cette personne fait déjà partie de votre équipe."
msgstr "This person is already part of your team."

#: apps/backoffice/forms.py:556 apps/plateforme/formulaires.py:181
msgid "Le nom est obligatoire pour un nouveau compte."
msgstr "A name is required for a new account."

#: apps/backoffice/forms.py:571 apps/backoffice/vues_equipe.py:281
msgid "Rôle inconnu."
msgstr "Unknown role."

#: apps/backoffice/forms.py:629
msgid "Caractère"
msgstr "Character"

#: apps/backoffice/forms.py:664
#, python-format
msgid ""
"Ce fichier pèse %(valeur)s Mo. Un logo doit rester sous 3 Mo — au-delà, il "
"ralentit chaque page de votre boutique."
msgstr ""
"This file weighs %(valeur)s MB. A logo must stay under 3 MB — beyond that, "
"it slows down every page of your shop."

#: apps/backoffice/forms.py:675
#, python-format
msgid ""
"Cette image fait %(largeur)s × %(hauteur)s pixels. Un logo n'a pas besoin de"
" dépasser 5000 × 5000 ; réduisez-la avant de l'envoyer."
msgstr ""
"This image is %(largeur)s × %(hauteur)s pixels. A logo does not need to "
"exceed 5000 × 5000; shrink it before uploading."

#: apps/backoffice/forms.py:686
msgid "Couleur illisible : attendu un code de la forme #1E88E5."
msgstr "Unreadable colour: expected a code like #1E88E5."

#: apps/backoffice/forms.py:783
msgid "Cet article n'existe pas dans votre boutique, ou il a déjà une fiche."
msgstr "This item does not exist in your shop, or it already has a recipe."

#: apps/backoffice/forms.py:833
msgid ""
"Cet ingrédient n'est pas disponible : il est déjà dans la fiche, c'est le "
"produit fabriqué lui-même, ou il n'existe pas ici."
msgstr ""
"This ingredient is not available: it is already in the recipe, it is the "
"manufactured product itself, or it does not exist here."

#: apps/backoffice/forms.py:893
msgid "Ce produit n'est pas fabriqué dans votre boutique."
msgstr "This product is not manufactured in your shop."

#: apps/backoffice/forms.py:952
msgid "L'année de fin précède l'année de début."
msgstr "The end year is before the start year."

#: apps/backoffice/forms.py:966
msgid "Cette compatibilité est déjà déclarée."
msgstr "This compatibility is already declared."

#: apps/backoffice/forms.py:1021
msgid "Une désignation vide ne rapproche rien de rien."
msgstr "An empty name matches nothing at all."

#: apps/backoffice/forms.py:1033
msgid "Cet article porte déjà cette désignation."
msgstr "This item already has this name."

#: apps/backoffice/views.py:1040 apps/backoffice/views.py:1546
#, python-format
msgid "%(n)s exemplaire nommé."
msgid_plural "%(n)s exemplaires nommés."
msgstr[0] "%(n)s unit named."
msgstr[1] "%(n)s units named."

#: apps/backoffice/views.py:1096
#, python-format
msgid "%(n)s numéro effacé : "
msgid_plural "%(n)s numéros effacés : "
msgstr[0] "%(n)s number deleted: "
msgstr[1] "%(n)s numbers deleted: "

#: apps/backoffice/views.py:1102
#, python-format
msgid ""
"%(numero)s est %(lower)s : il porte une histoire — une vente, une garantie, "
"un passage à l'atelier — et ne s'efface pas."
msgstr ""
"%(numero)s is %(lower)s: it carries a history — a sale, a warranty, a repair"
" — and cannot be erased."

#: apps/backoffice/views.py:1134
msgid "Compatibilité corrigée."
msgstr "Compatibility corrected."

#: apps/backoffice/views.py:1154
#, python-format
msgid "%(n)s compatibilité retirée."
msgid_plural "%(n)s compatibilités retirées."
msgstr[0] "%(n)s compatibility removed."
msgstr[1] "%(n)s compatibilities removed."

#: apps/backoffice/views.py:1218
#, python-format
msgid "« %(element)s » désigne aussi cet article."
msgstr "“%(element)s” also refers to this item."

#: apps/backoffice/views.py:1246
msgid "Désignation corrigée."
msgstr "Name corrected."

#: apps/backoffice/views.py:1268
#, python-format
msgid "%(n)s désignation retirée."
msgid_plural "%(n)s désignations retirées."
msgstr[0] "%(n)s name removed."
msgstr[1] "%(n)s names removed."

#: apps/backoffice/views.py:1297
#, python-format
msgid "« %(libelle)s » ajouté à votre stock."
msgstr "“%(libelle)s” added to your stock."

#: apps/backoffice/views.py:1379
#, python-format
msgid "« %(element)s » mis à jour."
msgstr "“%(element)s” updated."

#: apps/backoffice/views.py:1449
msgid "Aucun article à supprimer."
msgstr "No item to delete."

#: apps/backoffice/views.py:1463
#, python-format
msgid "%(n)s article supprimé : "
msgid_plural "%(n)s articles supprimés : "
msgstr[0] "%(n)s item deleted: "
msgstr[1] "%(n)s items deleted: "

#: apps/backoffice/views.py:1470
#, python-format
msgid "%(n)s article retiré de la vente (l'historique le garde) : "
msgid_plural "%(n)s articles retirés de la vente (l'historique les garde) : "
msgstr[0] "%(n)s item withdrawn from sale (its history is kept): "
msgstr[1] "%(n)s items withdrawn from sale (their history is kept): "

#: apps/backoffice/views.py:1485
#, python-format
msgid "%(debut)s et %(n)s autre."
msgid_plural "%(debut)s et %(n)s autres."
msgstr[0] "%(debut)s and %(n)s other."
msgstr[1] "%(debut)s and %(n)s others."

#: apps/backoffice/views.py:1669
msgid "Un transfert demande au moins deux dépôts."
msgstr "A transfer requires at least two warehouses."

#: apps/backoffice/views.py:1692
#, python-format
msgid "%(element)s unité(s) transférée(s) vers « %(libelle)s »."
msgstr "%(element)s unit(s) transferred to “%(libelle)s”."

#: apps/backoffice/views.py:1754
msgid "Aucune quantité saisie : l'inventaire n'a pas été enregistré."
msgstr "No quantity entered: the stock count was not saved."

#: apps/backoffice/views.py:1760
#, python-format
msgid ""
"Inventaire validé : %(comptees)s article(s) comptés, %(len)s écart(s) "
"régularisé(s)."
msgstr ""
"Stock count approved: %(comptees)s item(s) counted, %(len)s difference(s) "
"adjusted."

#: apps/backoffice/views.py:1789
msgid "Aucun dépôt n'est ouvert : créez-en un avant d'encaisser."
msgstr "No warehouse is open: create one before taking payments."

#: apps/backoffice/views.py:1801
#, python-format
msgid "Caisse ouverte sur « %(libelle)s »."
msgstr "Till opened at “%(libelle)s”."

#: apps/backoffice/views.py:1811
msgid "Caisse fermée, aucun écart."
msgstr "Till closed, no difference."

#: apps/backoffice/views.py:1815
#, python-format
msgid "Caisse fermée avec un %(signe)s de %(abs)s FCFA."
msgstr "Till closed with a %(signe)s of %(abs)s FCFA."

#: apps/backoffice/views.py:2249
msgid "Un dépôt sans nom ne se distingue pas des autres."
msgstr "A warehouse without a name cannot be told apart from the others."

#: apps/backoffice/views.py:2259
#, python-format
msgid "Dépôt renommé en « %(libelle)s »."
msgstr "Warehouse renamed to “%(libelle)s”."

#: apps/backoffice/views.py:2278
msgid "Aucun dépôt à fermer."
msgstr "No warehouse to close."

#: apps/backoffice/views.py:2297
#, python-format
msgid "Dépôt supprimé : %(enumerer)s"
msgstr "Warehouse deleted: %(enumerer)s"

#: apps/backoffice/views.py:2301
#, python-format
msgid ""
"Dépôt fermé (son historique de mouvements reste lisible) : %(enumerer)s"
msgstr ""
"Warehouse closed (its movement history remains readable): %(enumerer)s"

#: apps/backoffice/views.py:2306
#, python-format
msgid ""
"« %(nom)s » est le dépôt principal : désignez-en un autre avant de le "
"fermer."
msgstr ""
"“%(nom)s” is the main warehouse: designate another one before closing it."

#: apps/backoffice/views.py:2353
#, python-format
msgid ""
"Votre emplacement autorise %(quota)s dépôt(s). Passez à une offre supérieure"
" pour en ouvrir un de plus."
msgstr ""
"Your stall allows %(quota)s warehouse(s). Upgrade to a higher plan to open "
"another one."

#: apps/backoffice/views.py:2368
#, python-format
msgid "Dépôt « %(libelle)s » ouvert."
msgstr "Warehouse “%(libelle)s” opened."

#: apps/backoffice/vues_commandes.py:303
#, python-format
msgid ""
"Remise confirmée par le code de l'acheteur. Votre part sera libérée dans "
"%(delai)s jour, sauf réclamation."
msgid_plural ""
"Remise confirmée par le code de l'acheteur. Votre part sera libérée dans "
"%(delai)s jours, sauf réclamation."
msgstr[0] ""
"Handover confirmed by the buyer's code. Your share will be released in "
"%(delai)s day, unless a claim is made."
msgstr[1] ""
"Handover confirmed by the buyer's code. Your share will be released in "
"%(delai)s days, unless a claim is made."

#: apps/backoffice/vues_commandes.py:327
msgid "Cette commande a changé d'état entre-temps : rechargez la page."
msgstr "This order has changed status in the meantime: reload the page."

#: apps/backoffice/vues_commandes.py:338
#, python-format
msgid "Commande %(numero)s expédiée. Le stock est sorti au coût moyen."
msgstr "Order %(numero)s shipped. Stock was released at average cost."

#: apps/backoffice/vues_commandes.py:343
#, python-format
msgid "Commande %(numero)s %(participe)s."
msgstr "Order %(numero)s %(participe)s."

#: apps/backoffice/vues_commandes.py:364
#, python-format
msgid ""
"Commande %(numero)s refusée. Les commissions d'affiliation sont annulées ; "
"le stock n'avait pas encore bougé."
msgstr ""
"Order %(numero)s refused. Affiliate commissions are cancelled; stock had not"
" moved yet."

#: apps/backoffice/vues_commandes.py:375
msgid "Un retour se justifie : indiquez le motif."
msgstr "A return needs a reason: enter it."

#: apps/backoffice/vues_commandes.py:387
msgid ""
"Retour accepté. La marchandise est réintégrée au coût auquel elle était "
"sortie."
msgstr ""
"Return accepted. The goods are put back into stock at the cost at which they"
" left."

#: apps/backoffice/vues_equipe.py:101
#, python-format
msgid ""
"Votre emplacement autorise %(quota)s utilisateur(s). Retirez un accès, ou "
"passez à une offre supérieure."
msgstr ""
"Your stall allows %(quota)s user(s). Remove an access, or upgrade to a "
"higher plan."

#: apps/backoffice/vues_equipe.py:188
msgid "Aucun accès actif à retirer."
msgstr "No active access to remove."

#: apps/backoffice/vues_equipe.py:205
#, python-format
msgid ""
"Accès retiré à %(join)s. Leur historique de ventes et de mouvements reste "
"intact."
msgstr ""
"Access removed for %(join)s. Their sales and movement history remains "
"intact."

#: apps/backoffice/vues_equipe.py:208
#, python-format
msgid "Accès conservé pour %(refus)s."
msgstr "Access kept for %(refus)s."

#: apps/backoffice/vues_equipe.py:247
#, python-format
msgid "Compte créé pour %(nom_complet)s."
msgstr "Account created for %(nom_complet)s."

#: apps/backoffice/vues_equipe.py:251
#, python-format
msgid ""
"%(nom_complet)s avait déjà un compte HyperMarché : il est rattaché à votre "
"boutique, avec son mot de passe habituel."
msgstr ""
"%(nom_complet)s already had a HyperMarché account: it is linked to your "
"shop, with their usual password."

#: apps/backoffice/vues_equipe.py:292
msgid ""
"C'est le dernier gérant de la boutique : nommez d'abord quelqu'un d'autre."
msgstr "This is the shop's last manager: appoint someone else first."

#: apps/backoffice/vues_equipe.py:299
#, python-format
msgid "%(nom_complet)s a déjà ce rôle."
msgstr "%(nom_complet)s already has this role."

#: apps/backoffice/vues_equipe.py:307
#, python-format
msgid "%(nom_complet)s passe de « %(ancien)s » à « %(libelle)s »."
msgstr "%(nom_complet)s goes from “%(ancien)s” to “%(libelle)s”."

#: apps/backoffice/vues_equipe.py:325
msgid "Vous ne pouvez pas retirer votre propre accès."
msgstr "You cannot remove your own access."

#: apps/backoffice/vues_equipe.py:329
msgid "C'est le dernier gérant de la boutique."
msgstr "This is the shop's last manager."

#: apps/backoffice/vues_equipe.py:337
#, python-format
msgid ""
"Accès retiré à %(nom_complet)s. Son historique de ventes et de mouvements "
"reste intact."
msgstr ""
"Access removed for %(nom_complet)s. Their sales and movement history remains"
" intact."

#: apps/backoffice/vues_equipe.py:354
#, python-format
msgid "Votre emplacement autorise %(quota)s utilisateur(s)."
msgstr "Your stall allows %(quota)s user(s)."

#: apps/backoffice/vues_equipe.py:360
#, python-format
msgid "%(nom_complet)s retrouve son accès."
msgstr "%(nom_complet)s has their access back."

#: apps/backoffice/vues_equipe.py:380
msgid "Changez votre propre mot de passe depuis votre compte, pas depuis ici."
msgstr "Change your own password from your account, not from here."

#: apps/backoffice/vues_equipe.py:404
msgid "Son rôle ne traite pas les commandes : il n'y a rien à lui envoyer."
msgstr "Their role does not handle orders: there is nothing to send them."

#: apps/backoffice/vues_identite.py:81
#, python-format
msgid ""
"Charte enregistrée. Une correction a été appliquée : %(motif_ajustement)s"
msgstr ""
"Brand guidelines saved. A correction was applied: %(motif_ajustement)s"

#: apps/backoffice/vues_identite.py:84
msgid "Charte enregistrée."
msgstr "Brand guidelines saved."

#: apps/backoffice/vues_identite.py:202
#, python-format
msgid "Lien créé : %(build_absolute_uri)s"
msgstr "Link created: %(build_absolute_uri)s"

#: apps/backoffice/vues_identite.py:219
msgid "Un lien sans usage ne se retrouve pas dans la liste."
msgstr "A link without a purpose cannot be found in the list."

#: apps/backoffice/vues_identite.py:223
#, python-format
msgid "Lien renommé en « %(libelle)s »."
msgstr "Link renamed to “%(libelle)s”."

#: apps/backoffice/vues_identite.py:238
#, python-format
msgid "« %(libelle)s » ne redirige plus."
msgstr "“%(libelle)s” no longer redirects."

#: apps/backoffice/vues_identite.py:253
msgid "Aucun lien actif à retirer."
msgstr "No active link to remove."

#: apps/backoffice/vues_identite.py:260
#, python-format
msgid "%(n)s lien ne redirige plus : %(liens)s. Son compteur reste lisible."
msgid_plural ""
"%(n)s liens ne redirigent plus : %(liens)s. Leurs compteurs restent "
"lisibles."
msgstr[0] ""
"%(n)s link no longer redirects: %(liens)s. Its counter stays readable."
msgstr[1] ""
"%(n)s links no longer redirect: %(liens)s. Their counters stay readable."

#: apps/backoffice/vues_ordonnancier.py:98
#, python-format
msgid "Ordonnance consignée pour le ticket %(numero)s."
msgstr "Prescription recorded for receipt %(numero)s."

#: apps/backoffice/vues_production.py:164
#, python-format
msgid ""
"%(quantite)s × %(variante)s produits · %(len)s ingrédients consommés · "
"revient à %(cout_unitaire)s FCFA l'unité."
msgstr ""
"%(quantite)s × %(variante)s produced · %(len)s ingredients used · costs "
"%(cout_unitaire)s FCFA per unit."

#: apps/backoffice/vues_production.py:167
#, python-format
msgid "%(quantite)s × %(variante)s produits."
msgstr "%(quantite)s × %(variante)s produced."

#: apps/backoffice/vues_production.py:192
msgid "Invendus enregistrés."
msgstr "Unsold items recorded."

#: apps/backoffice/vues_production.py:249
msgid "Fiche ouverte. Ajoutez maintenant ses ingrédients."
msgstr "Recipe opened. Now add its ingredients."

#: apps/backoffice/vues_production.py:346
msgid "Un ingrédient entre pour une quantité positive."
msgstr "An ingredient goes in for a positive quantity."

#: apps/backoffice/vues_production.py:350
msgid "Quantité corrigée."
msgstr "Quantity corrected."

#: apps/backoffice/vues_production.py:372
#, python-format
msgid "%(n)s ingrédient retiré de la fiche."
msgid_plural "%(n)s ingrédients retirés de la fiche."
msgstr[0] "%(n)s ingredient removed from the recipe."
msgstr[1] "%(n)s ingredients removed from the recipe."

#: apps/backoffice/vues_production.py:413
msgid "Le rendement d'une fiche est une quantité positive."
msgstr "A recipe's yield is a positive quantity."

#: apps/backoffice/vues_production.py:422
#, python-format
msgid "Fiche « %(variante)s » mise à jour."
msgstr "Recipe “%(variante)s” updated."

#: apps/backoffice/vues_production.py:445
msgid "Aucune fiche à supprimer."
msgstr "No recipe to delete."

#: apps/backoffice/vues_production.py:462
#, python-format
msgid "Fiche supprimée : %(join)s."
msgstr "Recipe deleted: %(join)s."

#: apps/backoffice/vues_production.py:466
#, python-format
msgid ""
"Fiche retirée de la production (elle explique des fournées déjà faites) : "
"%(join)s."
msgstr ""
"Recipe withdrawn from production (it explains batches already made): "
"%(join)s."

#: apps/backoffice/vues_sav.py:127
msgid "Indiquez la panne constatée : c'est elle qui se retrouve."
msgstr "Describe the fault found: that is what will be searched for later."

#: apps/backoffice/vues_sav.py:139
#, python-format
msgid "%(numero)s déposé à l'atelier, %(couverture)s."
msgstr "%(numero)s dropped off at the workshop, %(couverture)s."

#: apps/backoffice/vues_sav.py:155
#, python-format
msgid "%(numero)s n'est pas à l'atelier."
msgstr "%(numero)s is not at the workshop."

#: apps/backoffice/vues_sav.py:157
#, python-format
msgid "%(numero)s est ressorti de l'atelier."
msgstr "%(numero)s has left the workshop."

#: apps/backoffice/vues_verification.py:61
#, python-format
msgid ""
"Compte déclaré. Un administrateur va le vérifier ; il ne recevra de "
"versement que %(int)s heures après."
msgstr ""
"Account declared. An administrator will check it; it will only receive a "
"payout %(int)s hours later."

#: apps/backoffice/vues_verification.py:124
msgid "Merci. Le compte de versement est confirmé de votre part."
msgstr "Thank you. You have confirmed the payout account."

#: apps/backoffice/vues_verification.py:136
msgid ""
"Ce compte est retiré et aucun versement n'y partira. L'équipe HyperMarché "
"est prévenue et vous contactera. Changez votre mot de passe, puis déclarez "
"votre vrai compte ci-dessous."
msgstr ""
"This account is withdrawn and no payout will go to it. The HyperMarché team "
