msgid ""
"Aucun administrateur du marché : tout passe par le superadministrateur, ce "
"que l'ADR-012 appelle une transition, pas une cible."
msgstr ""
"No market administrator: everything goes through the superadministrator, "
"which ADR-012 calls a transition, not a target."

#: templates/plateforme/administrateurs.html:104
msgid "Rôles révolus"
msgstr "Former roles"

#: templates/plateforme/administrateurs.html:105
#: templates/plateforme/litige.html:63
