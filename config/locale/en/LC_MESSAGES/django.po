msgstr "For which shop?"

#: templates/plateforme/assistants/emplacement_boutique.html:5
msgid ""
"Seule une boutique active occupe un emplacement : les autres ne sont pas en "
"vitrine."
msgstr ""
"Only an active shop occupies a placement: the others are not on the market."

#: templates/plateforme/assistants/emplacement_boutique.html:10
msgid "Rechercher une boutique active"
msgstr "Search for an active shop"

#: templates/plateforme/assistants/emplacement_boutique.html:12
msgid "Enseigne, raison sociale ou ville"
msgstr "Shop name, company name or city"

