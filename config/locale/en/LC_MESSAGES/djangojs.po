msgid "La fin doit venir après le début."
msgstr "The end must come after the start."

#: static/js/tableau.js:93
msgid "Tout sélectionner"
msgstr "Select all"

#: static/js/tableau.js:104
msgid "Sélectionner %(libelle)s"
msgstr "Select %(libelle)s"

#: static/js/tableau.js:104
msgid "cette ligne"
msgstr "this row"

