msgid "Modifier « %(libelle)s »"
msgstr "Edit “%(libelle)s”"

#: static/js/tableau.js:178
msgid "On ne modifie qu'une ligne à la fois : choisissez-en une seule."
msgstr "Only one row can be edited at a time: choose just one."

#: static/js/tableau.js:180
msgid "Cette ligne ne se modifie pas."
msgstr "This row cannot be edited."

#: static/js/tableau.js:181
msgid "Sélectionnez une ligne à modifier."
msgstr "Select a row to edit."

#: static/js/tableau.js:187
msgid "Supprimer %(n)s %(noms)s"
