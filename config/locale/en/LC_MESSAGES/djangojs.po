#: static/js/tableau.js:192
msgid "Aucune des lignes choisies ne peut être supprimée."
msgstr "None of the selected rows can be deleted."

#: static/js/tableau.js:193
msgid "Sélectionnez au moins une ligne à supprimer."
msgstr "Select at least one row to delete."

#: static/js/tableau.js:211
msgid "Modifier"
msgstr "Edit"

#: static/js/tableau.js:216
msgid "ouvre ses réglages"
msgstr "opens its settings"

#: static/js/tableau.js:216
msgid "ouvre sa fiche"
msgstr "opens its page"

#: static/js/tableau.js:220
msgid "s'y applique"
msgstr "applies to it"

#: static/js/tableau.js:236
msgid "sélectionné"
msgstr "selected"

#: static/js/tableau.js:249
msgid "sélectionnés"
msgstr "selected"

#: static/js/tableau.js:250
msgid " — seule la <b>suppression</b> s'applique à plusieurs lignes"
msgstr " — only <b>deletion</b> applies to several rows"

