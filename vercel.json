{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pip install --disable-pip-version-check -r requirements.txt",
  "buildCommand": "mkdir -p sortie_vide && : > sortie_vide/.vide && python manage.py collectstatic --noinput && python manage.py migrate --noinput && python manage.py verifier_rls && python manage.py preparer_demo",
  "outputDirectory": "sortie_vide",
  "regions": [
    "pdx1"
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "{apps,config,templates,staticfiles}/**"
    }
  },
  "env": {
    "DEBUG": "False",
    "SANS_SERVEUR": "True",
    "AFFICHER_COMPTE_DEMO": "True",
    "CELERY_TASK_ALWAYS_EAGER": "True",
    "SECURE_SSL_REDIRECT": "False",
    "SECURE_HSTS_SECONDS": "3600"
  }
}
